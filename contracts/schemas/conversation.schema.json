{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conversation.schema.json",
  "title": "Conversation",
  "description": "One synthetic or hand-written multi-turn conversation. One JSON object per line in data/**/*.jsonl.",
  "type": "object",
  "required": ["id", "family", "channel", "turns", "strike_turn", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
    "family": {"type": "string", "pattern": "^(benign|pig_butchering|bank_impersonation|family_emergency|job_task|toll_delivery|carrier_support|zd_[a-z0-9_]+)$"},
    "channel": {"enum": ["sms", "imessage", "rcs", "whatsapp", "email", "other"]},
    "hard_negative": {"type": "boolean", "default": false, "description": "Benign conversation written to look like a scam opening."},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["sender", "text", "stage"],
        "additionalProperties": false,
        "properties": {
          "sender": {"enum": ["them", "me"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "stage": {"enum": ["benign", "bait", "pivot", "hook", "strike"]}
        }
      }
    },
    "strike_turn": {"type": ["integer", "null"], "minimum": 0, "description": "0-based index of the first strike turn; null for benign."},
    "split": {"enum": ["train", "val", "test", "test_human"]},
    "source": {
      "type": "object",
      "required": ["generator"],
      "additionalProperties": false,
      "properties": {
        "generator": {"enum": ["nemotron", "human", "other_llm"]},
        "model": {"type": "string"},
        "prompt_id": {"type": "string"},
        "seed": {"type": "integer"},
        "critic_realism": {"type": "number", "minimum": 1, "maximum": 5},
        "zero_day_alert": {"type": "string"}
      }
    }
  }
}
