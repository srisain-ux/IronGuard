{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zero_day_request.schema.json",
  "type": "object",
  "properties": {
    "alert": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "\\S"
    },
    "n_pos": {"type": "integer", "minimum": 10, "maximum": 300, "default": 120},
    "n_neg": {"type": "integer", "minimum": 10, "maximum": 300, "default": 120}
  },
  "required": [
    "alert"
  ],
  "additionalProperties": false
}
