{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safety_card.schema.json",
  "title": "SafetyCard",
  "description": "Output of the Nemotron Safeguard Agent (POST /v1/agent/safety-card). Rendered as a card in /phone and as a text reply in Photon.",
  "type": "object",
  "required": ["verdict", "confidence", "headline", "why", "entities", "checks", "next_steps", "privacy_note"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"enum": ["safe", "caution", "likely_scam"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Copied from ScoreResponse.risk; the agent may NOT invent or inflate it."},
    "confidence_band": {"enum": ["low", "uncertain", "high"]},
    "headline": {"type": "string", "maxLength": 120},
    "why": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 160}},
    "entities": {
      "type": "object",
      "required": ["brands", "phones", "urls"],
      "additionalProperties": false,
      "properties": {
        "brands": {"type": "array", "items": {"type": "string"}},
        "phones": {"type": "array", "items": {"type": "string"}},
        "urls": {"type": "array", "items": {"type": "string"}}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "input", "ok", "summary"],
        "additionalProperties": false,
        "properties": {
          "tool": {"enum": ["lookup_official_contact", "check_domain", "check_number", "scrub_and_report"]},
          "input": {"type": "string"},
          "ok": {"type": "boolean", "description": "true = matches official / looks safe; false = mismatch / risky."},
          "summary": {"type": "string", "maxLength": 200},
          "data": {"type": "object"}
        }
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "action"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string", "maxLength": 60},
          "reply_code": {"type": "string", "pattern": "^[1-9]$", "description": "Photon: what the user texts back to pick this."},
          "action": {"enum": ["call_official", "open_official_site", "block_report", "mark_safe", "cool_down", "learn_more"]},
          "payload": {"type": "object"}
        }
      }
    },
    "locked_links": {"type": "array", "items": {"type": "string"}, "description": "URLs / numbers the UI must render non-clickable."},
    "cool_down": {"type": "boolean", "description": "Show the Cool-Down Shield (high-urgency language detected)."},
    "privacy_note": {"type": "string", "maxLength": 200, "description": "Exactly what left the device for this card."}
  }
}
