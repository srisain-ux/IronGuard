# Copy to .env in the service folder that needs it. Never commit real values.
# ---- B: api ----
NVIDIA_API_KEY=nvapi-xxxxxxxx
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_GEN_MODEL=nvidia/nemotron-3-nano-30b-a3b          # bulk data generation (check exact id on build.nvidia.com)
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b     # tool-calling agent + critic (verify id on build.nvidia.com)
IRONGUARD_MODEL=stub                                          # stub | preynet
IRONGUARD_ARTIFACTS=../ml/artifacts
CORS_ORIGINS=http://localhost:5173
# ---- C: bridge (Photon) ----
PHOTON_PROJECT_ID=
PHOTON_SECRET=
PHOTON_WEBHOOK_SECRET=        # shown ONCE at webhook registration: save it immediately
IRONGUARD_API_URL=http://localhost:8000
MOCK_API=0
# ---- C: web ----
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=1
