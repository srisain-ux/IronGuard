# Copy to .env in the service folder that needs it. Never commit real values.
# ---- B: api ----
# Nemotron, OPTION A (our choice): self-hosted on NVIDIA Brev, reached through `make brev-tunnel` (port 8001 on this laptop)
NEMOTRON_BASE_URL=http://localhost:8001/v1
NVIDIA_API_KEY=the-password-you-gave-brev_serve.sh
NEMOTRON_GEN_MODEL=nemotron
NEMOTRON_AGENT_MODEL=nemotron
# Nemotron, OPTION B (backup): build.nvidia.com hosted API. To switch, replace the 4 lines above with:
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=nvapi-xxxxxxxx
# NEMOTRON_GEN_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NEMOTRON_AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
IRONGUARD_MODEL=stub                                          # stub | preynet
IRONGUARD_ARTIFACTS=../ml/artifacts
CORS_ORIGINS=http://localhost:5173
# ---- C: bridge (Photon) ----
PHOTON_PROJECT_ID=
PHOTON_SECRET=
PHOTON_WEBHOOK_SECRET=        # shown ONCE at webhook registration: save it immediately
IRONGUARD_API_URL=http://localhost:8000
MOCK_API=0
# ---- C: web ----
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=1
